    {
      "name": "8. Saga — Sipariş Ver",
      "description": "POST /api/orders (status yok) orchestrator'ı başlatır. Adım adım Kafka UI lab: docs/kafka-saga-lab.md (http://localhost:8090).\n\nMutlu yol: CONFIRMED + payment CAPTURED + delivery ASSIGNED.\nRed: CANCELLED + cancelReason + payment REFUNDED.",
      "item": [
        {
          "name": "Sipariş Ver (mutlu yol)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"totalAmount\": 149.9,\n  \"forceRestaurantAccept\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "forceRestaurantAccept %20 rastgele red'i kapatır. Cevap hemen AWAITING_PAYMENT olur; 1–3 sn sonra Get order → CONFIRMED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const id = pm.response.json().id;",
                  "  if (id) pm.collectionVariables.set('orderId', id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order (saga sonucu)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/api/orders/{{orderId}}",
            "description": "2–3 saniye bekle, tekrar gönder. Mutlu yol: CONFIRMED. Red: CANCELLED + cancelReason. AWAITING_PAYMENT takılıysa payment-events boş olabilir — aşağıdaki replay'i kullan."
          }
        },
        {
          "name": "Saga adımını tekrarla (takılı AWAITING_*)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{gateway}}/api/orders/{{orderId}}/saga/replay",
            "description": "REST ile payment oluşturmaz. AWAITING_PAYMENT ise ChargePaymentCommand'ı tekrar payment-commands'a yazar. payment-service ayakta olmalı."
          }
        },
        {
          "name": "List payments (saga yan etkisi)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/api/payments",
            "description": "Mutlu yol CAPTURED, compensate REFUNDED. Elle POST /payments atmana gerek yok."
          }
        },
        {
          "name": "List deliveries (saga yan etkisi)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/api/deliveries"
          }
        },
        {
          "name": "Sipariş Ver (restoran red / compensate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"totalAmount\": 89.5,\n  \"forceRestaurantReject\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Restoran FORCE_REJECT → orchestrator RefundPaymentCommand → CANCELLED. restaurant-service: RESTAURANT REJECT. order-service: SAGA COMPENSATE. payment-service: PAYMENT REFUNDED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const id = pm.response.json().id;",
                  "  if (id) pm.collectionVariables.set('orderId', id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
