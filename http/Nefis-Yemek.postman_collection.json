{
  "info": {
    "name": "Nefis Yemek",
    "description": "Milestone 1 — tüm istekler api-gateway :8080 üzerinden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:8080" },
    { "key": "customerId", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Gateway health",
      "request": { "method": "GET", "header": [], "url": "{{gateway}}/actuator/health" }
    },
    {
      "name": "Create restaurant",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "if (pm.response.code === 201) pm.collectionVariables.set('restaurantId', pm.response.json().id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Adana Sofrası\",\n  \"address\": \"Kadıköy\",\n  \"cuisine\": \"Türk\",\n  \"open\": true\n}" },
        "url": "{{gateway}}/api/restaurants"
      }
    },
    {
      "name": "Create customer",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "if (pm.response.code === 201) pm.collectionVariables.set('customerId', pm.response.json().id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Ali Veli\",\n  \"email\": \"ali@example.com\",\n  \"phone\": \"5551112233\"\n}" },
        "url": "{{gateway}}/api/customers"
      }
    },
    {
      "name": "Add address",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Ev\",\n  \"street\": \"Caferağa\",\n  \"city\": \"İstanbul\"\n}" },
        "url": "{{gateway}}/api/customers/{{customerId}}/addresses"
      }
    },
    {
      "name": "Create order",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"totalAmount\": 149.90\n}" },
        "url": "{{gateway}}/api/orders"
      }
    },
    {
      "name": "Create payment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": 149.90\n}" },
        "url": "{{gateway}}/api/payments"
      }
    },
    {
      "name": "Assign courier",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"courierName\": \"Ahmet\"\n}" },
        "url": "{{gateway}}/api/deliveries"
      }
    },
    {
      "name": "Send mock SMS",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"recipient\": \"5551112233\",\n  \"channel\": \"SMS\",\n  \"message\": \"Siparis alindi\"\n}" },
        "url": "{{gateway}}/api/notifications"
      }
    }
  ]
}
